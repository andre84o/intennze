# ─────────────────────────────────────────────────────────────────────────────
# Environment template. Copy to .env.local and fill in real values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* vars are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── Customer-view (admin portal impersonation) ───────────────────────────────
# Optional; falls back to SUPABASE_SERVICE_ROLE_KEY if unset. Server-only.
CUSTOMER_VIEW_COOKIE_SECRET=

# ── Hostup domain registrar API v2 (server-only, read-only this phase) ────────
# Base URL for Hostup API v2. Defaults to the value below if unset.
HOSTUP_API_BASE_URL=https://cloud.hostup.se/api/v2
# Bearer token for Hostup. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
# This phase needs only the read:domains scope.
HOSTUP_API_KEY=
